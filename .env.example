# Datara environment configuration
# Copy this file to .env and fill in values.

# Database path (default: ~/.datara/datara.db)
# DATARA_DB_PATH=~/.datara/datara.db

# LLM API keys (at least one required for chat)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (OpenAI-compatible) example — point the provider at OpenRouter
# and whitelist the model slugs you want in the Settings dropdown:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_TIMEOUT=120
# DATARA_ALLOWED_MODELS=z-ai/glm-4.7-flash,meta-llama/llama-3.3-70b-instruct

# Server configuration
# DATARA_HOST=0.0.0.0
# DATARA_PORT=8000

# Sandbox limits
# DATARA_SANDBOX_TIMEOUT=30
# DATARA_SANDBOX_MEMORY_MB=512